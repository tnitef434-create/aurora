{
  "name": "aurora",
  "productName": "Aurora",
  "version": "1.5.0",
  "description": "Aurora — a space maze game",
  "main": "main.js",
  "scripts": {
    "start": "npm run bundle && electron .",
    "bundle": "node tools/check-levels.mjs && esbuild src/game.js --bundle --format=iife --minify --loader:.glb=binary --outfile=game.bundle.js",
    "models": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --factory-startup --python blender/build_models.py -- models && \"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --factory-startup --python blender/build_player.py -- models",
    "build": "npm run bundle && electron-packager . Aurora --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite --asar --ignore=\"^/(dist|src|models|blender|tools)(/|$)\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "three": "^0.186.0"
  }
}